{
  "appId": "com.aistudio.autoprint.rpgprt",
  "productName": "RPG AUTO PRINT",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis", "zip"],
    "artifactName": "rpg-autoprint-setup-${version}.${ext}"
  },
  "linux": {
    "target": ["AppImage", "tar.gz"],
    "artifactName": "rpg-autoprint-${version}.${ext}"
  }
}
